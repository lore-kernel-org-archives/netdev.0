-/*=20
- *  Function irtty_close (tty)
- *
- *    Close down a IrDA channel. This means flushing out any pending que=
ues,
- *    and then restoring the TTY line discipline to what it was before i=
t got
- *    hooked to IrDA (which usually is TTY again). =20
- */
-static void irtty_close(struct tty_struct *tty)=20
-{
-	struct irtty_cb *self =3D (struct irtty_cb *) tty->disc_data;
-	unsigned long flags;
-
-	IRDA_DEBUG(2, "%s()\n", __FUNCTION__);
-=09
-	/* First make sure we're connected. */
-	if (self =3D=3D NULL || self->tty !=3D tty)
-		return;
-
-	ASSERT(self->magic =3D=3D IRTTY_MAGIC, return;);
-
-	/* Stop tty */
-	tty->flags &=3D ~(1 << TTY_DO_WRITE_WAKEUP);
-	tty->disc_data =3D 0;
-
-	/* We are not using any dongle anymore! */
-	if (self->dongle)
-		irda_device_dongle_cleanup(self->dongle);
-	self->dongle =3D NULL;
-
-	/* Protect access to self->task and self->?x_buff - Jean II */
-	spin_lock_irqsave(&self->lock, flags);
-
-	/* Remove speed changing task if any */
-	if (self->task)
-		irda_task_delete(self->task);
-
-	self->tty =3D NULL;
-	self->magic =3D 0;
-=09
-	if (self->tx_buff.head)
-		kfree(self->tx_buff.head);
-=09
-	if (self->rx_buff.head)
-		kfree(self->rx_buff.head);
-	spin_unlock_irqrestore(&self->lock, flags);
-=09
-	/* Remove netdevice */
-	unregister_netdev(self->netdev);
-}
