-				    struct ieee80211_tx_rate *rate,
-				    struct ieee80211_tx_rate_control *txrc,
-				    u8 tries, char rix, int rtsctsenable,
-				    bool not_data)
-{
-	struct rtl_mac *mac =3D rtl_mac(rtlpriv);
-	u8 sgi_20 =3D 0, sgi_40 =3D 0;
-
-	if (sta) {
-		sgi_20 =3D sta->ht_cap.cap & IEEE80211_HT_CAP_SGI_20;
-		sgi_40 =3D sta->ht_cap.cap & IEEE80211_HT_CAP_SGI_40;
-	}
-	rate->count =3D tries;
-	rate->idx =3D rix >=3D 0x00 ? rix : 0x00;
-
-	if (!not_data) {
