-							READEF1BYTE(ie+index);
-					index +=3D 1;
-					p2pinfo->noa_duration[i] =3D
-							READEF4BYTE(ie+index);
-					index +=3D 4;
-					p2pinfo->noa_interval[i] =3D
-							READEF4BYTE(ie+index);
-					index +=3D 4;
-					p2pinfo->noa_start_time[i] =3D
-							READEF4BYTE(ie+index);
-					index +=3D 4;
-				}
-
-				if (p2pinfo->opp_ps =3D=3D 1) {
-					p2pinfo->p2p_ps_mode =3D P2P_PS_CTWINDOW;
-					/* Driver should wait LPS
-					 * entering CTWindow*/
-					if (rtlpriv->psc.b_fw_current_inpsmode){
-						rtl_p2p_ps_cmd(hw,
-							       P2P_PS_ENABLE);
-					}
