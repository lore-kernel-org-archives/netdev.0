-static void rtl_get_rate(void *ppriv, struct ieee80211_sta *sta,
-			 void *priv_sta,
-			 struct ieee80211_tx_rate_control *txrc)
-{
-	struct rtl_priv *rtlpriv =3D ppriv;
-	struct sk_buff *skb =3D txrc->skb;
-	struct ieee80211_tx_info *tx_info =3D IEEE80211_SKB_CB(skb);
-	struct ieee80211_tx_rate *rates =3D tx_info->control.rates;
-	__le16 fc =3D rtl_get_fc(skb);
-	u8 try_per_rate, i, rix;
-	bool not_data =3D !ieee80211_is_data(fc);
