-	.type =3D IRDA_ACTISYS_PLUS_DONGLE,
-	.open =3D actisys_open,
-	.close =3D actisys_close,
-	.reset =3D actisys_reset,
-	.change_speed =3D actisys_change_speed,
-	.owner =3D THIS_MODULE,
-};
