-	struct ieee80211_hw *hw =3D wiphy_to_ieee80211_hw(wiphy);
-	struct rtl_priv *rtlpriv =3D rtl_priv(hw);
-
-	RT_TRACE(COMP_REGD, DBG_LOUD, ("\n"));
