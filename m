-/*=20
- *  Function irtty_receive_buf( tty, cp, count)
- *
- *    Handle the 'receiver data ready' interrupt.  This function is call=
ed
- *    by the 'tty_io' module in the kernel when a block of IrDA data has
- *    been received, which can now be decapsulated and delivered for
- *    further processing=20
- */
-static void irtty_receive_buf(struct tty_struct *tty, const unsigned cha=
r *cp,
-			      char *fp, int count)=20
-{
-	struct irtty_cb *self =3D (struct irtty_cb *) tty->disc_data;
-
-	if (!self || !self->netdev) {
-		IRDA_DEBUG(0, "%s(), not ready yet!\n", __FUNCTION__);
-		return;
-	}
-
-	// Are we in interrupt context ? What locking is done ? - Jean II
-	//spin_lock_irqsave(&self->lock, flags);
-
