-		return -ENOMEM;
-
-	return 0;
-}
-
-void mlx5_sriov_cleanup(struct mlx5_core_dev *dev)
-{
-	struct mlx5_core_sriov *sriov = &dev->priv.sriov;
-
-	if (!mlx5_core_is_pf(dev))
-		return;
-
-	kfree(sriov->vfs_ctx);
-}
