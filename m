> >> +
> >> +	gen_time_host = ktime_sub(ptp->mc_base_time,
> >> +				  ptp->host_base_time);
> >> +	event_gen_time = ktime_to_timespec(gen_time_host);
> >> +
> >> +	ptp_pps_evt.type = PTP_CLOCK_EXTTS;
