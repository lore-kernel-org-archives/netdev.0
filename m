@@ -670,13 +670,9 @@ static int qed_spq_pend_post(struct qed_
 		qed_spq_add_entry(p_hwfn, p_ent, p_ent->priority);
 	}
 
-	rc = qed_spq_post_list(p_hwfn,
+	return qed_spq_post_list(p_hwfn,
