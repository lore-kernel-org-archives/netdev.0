-# Old SIR drivers (irtty is broken)
-obj-$(CONFIG_IRTTY_OLD)		+=3D irtty.o
+# Old SIR drivers=20
 obj-$(CONFIG_IRPORT_SIR)	+=3D 		irport.o
 # FIR drivers
 obj-$(CONFIG_USB_IRDA)		+=3D irda-usb.o
