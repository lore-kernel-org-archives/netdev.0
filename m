-	if (ppsc->inactive_pwrstate =3D=3D ERFOFF &&
-	    rtlhal->interface =3D=3D INTF_PCI) {
-		if (ppsc->reg_rfps_level & RT_RF_OFF_LEVL_ASPM &&
