-		break;
-	case 2400:
-		cflag |=3D B2400;
-		break;
-	case 4800:
-		cflag |=3D B4800;
-		break;
-	case 19200:
-		cflag |=3D B19200;
-		break;
-	case 38400:
-		cflag |=3D B38400;
-		break;
-	case 57600:
-		cflag |=3D B57600;
-		break;
-	case 115200:
-		cflag |=3D B115200;
-		break;
-	case 9600:
-	default:
-		cflag |=3D B9600;
-		break;
-	}=09
-
-	/* This is unsafe, but currently under discussion - Jean II */
-	self->tty->termios->c_cflag =3D cflag;
-	self->tty->driver->set_termios(self->tty, &old_termios);
