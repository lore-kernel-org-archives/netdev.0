-		break;
-		}
-		ie +=3D 3 + noa_len;
-	}
-
-	if (find_p2p_ie =3D=3D true) {
-		if ((p2pinfo->p2p_ps_mode > P2P_PS_NONE) &&
-		    (find_p2p_ps_ie =3D=3D false))
