#include <sys/types.h>
#include <sys/stat.h>
#include <stddef.h>
#include <string.h>
#include <unistd.h>

int main()
{
  int sock = socket(41 /*AF_KCM*/, SOCK_SEQPACKET, 0);
  struct mmsghdr msg;
  memset(&msg, 0, sizeof(msg));
  sendmmsg(sock, &msg, 1, 0);
  return 0;
}


