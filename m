 drivers/net/chelsio/ixf1010.c     |  505 --------------------------------------
 drivers/net/chelsio/vsc8244.c     |  367 ---------------------------
 drivers/net/chelsio/vsc8244_reg.h |  172 ------------
 4 files changed, 1 insertion(+), 1047 deletions(-)

