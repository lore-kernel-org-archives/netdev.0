Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: QUOTED-PRINTABLE
To: netdev@vger.kernel.org, davem@davemloft.net
Return-path: <netdev-owner@vger.kernel.org>
Received: from cmrelayp1.emulex.com ([138.239.112.140]:52739 "EHLO
	CMRELAYP1.ad.emulex.com" rhost-flags-OK-FAIL-OK-FAIL)
	by vger.kernel.org with ESMTP id S1752945AbcBJRRs (ORCPT
	<rfc822;netdev@vger.kernel.org>); Wed, 10 Feb 2016 12:17:48 -0500
In-Reply-To: <1455124554-7819-1-git-send-email-ajit.khaparde@broadcom.com>
Sender: netdev-owner@vger.kernel.org
List-ID: <netdev.vger.kernel.org>

=46rom: Ajit Khaparde <ajit.khaparde@broadcom.com>

=46rom FW version 11.0. onwards, the PORT_MISCONFIG event generated by =
the FW
will carry more information about the event in the "data_word1"
and "data_word2" fields. This patch adds support in the driver to parse=
 the
new information and log it accordingly. This patch also changes some of=
 the
messages that are being logged currently.

Signed-off-by: Suresh Reddy <suresh.reddy@broadcom.com>
Signed-off-by: Venkat Duvvuru <venkatkumar.duvvuru@broadcom.com>
Signed-off-by: Ajit Khaparde <ajit.khaparde@broadcom.com>
---
 drivers/net/ethernet/emulex/benet/be.h      |  5 +-
 drivers/net/ethernet/emulex/benet/be_cmds.c | 82 +++++++++++++++++++++=
--------
 drivers/net/ethernet/emulex/benet/be_cmds.h | 45 +++++++++++++++-
 drivers/net/ethernet/emulex/benet/be_main.c | 11 ++--
 4 files changed, 116 insertions(+), 27 deletions(-)

diff --git a/drivers/net/ethernet/emulex/benet/be.h b/drivers/net/ether=
net/emulex/benet/be.h
index 515e206..ab24f84 100644
--- a/drivers/net/ethernet/emulex/benet/be.h
+++ b/drivers/net/ethernet/emulex/benet/be.h
@@ -115,6 +115,8 @@
 #define	RSS_INDIR_TABLE_LEN	128
 #define RSS_HASH_KEY_LEN	40
=20
+#define BE_UNKNOWN_PHY_STATE	0xFF
+
 struct be_dma_mem {
 	void *va;
 	dma_addr_t dma;
@@ -390,7 +392,7 @@ enum vf_state {
 #define BE_FLAGS_QNQ_ASYNC_EVT_RCVD		BIT(7)
 #define BE_FLAGS_VXLAN_OFFLOADS			BIT(8)
 #define BE_FLAGS_SETUP_DONE			BIT(9)
-#define BE_FLAGS_EVT_INCOMPATIBLE_SFP		BIT(10)
+#define BE_FLAGS_PHY_MISCONFIGURED		BIT(10)
 #define BE_FLAGS_ERR_DETECTION_SCHEDULED	BIT(11)
 #define BE_FLAGS_OS2BMC				BIT(12)
=20
@@ -603,6 +605,7 @@ struct be_adapter {
 	u32 bmc_filt_mask;
 	u32 fat_dump_len;
 	u16 serial_num[CNTL_SERIAL_NUM_WORDS];
+	u8 phy_state; /* state of sfp optics (functional, faulted, etc.,) */
 };
=20
 #define be_physfn(adapter)		(!adapter->virtfn)
diff --git a/drivers/net/ethernet/emulex/benet/be_cmds.c b/drivers/net/=
ethernet/emulex/benet/be_cmds.c
index 33cbbde..66fa214 100644
--- a/drivers/net/ethernet/emulex/benet/be_cmds.c
+++ b/drivers/net/ethernet/emulex/benet/be_cmds.c
@@ -19,19 +19,25 @@
 #include "be.h"
 #include "be_cmds.h"
=20
-static char *be_port_misconfig_evt_desc[] =3D {
-	"A valid SFP module detected",
-	"Optics faulted/ incorrectly installed/ not installed.",
-	"Optics of two types installed.",
-	"Incompatible optics.",
-	"Unknown port SFP status"
+char *be_misconfig_evt_port_state[] =3D {
+	"Physical Link is functional",
+	"Optics faulted/incorrectly installed/not installed - Reseat optics. =
If issue not resolved, replace.",
+	"Optics of two types installed =E2=80=93 Remove one optic or install =
matching pair of optics.",
+	"Incompatible optics =E2=80=93 Replace with compatible optics for car=
d to function.",
+	"Unqualified optics =E2=80=93 Replace with Avago optics for Warranty =
and Technical Support.",
+	"Uncertified optics =E2=80=93 Replace with Avago-certified optics to =
enable link operation."
 };
=20
-static char *be_port_misconfig_remedy_desc[] =3D {
-	"",
-	"Reseat optics. If issue not resolved, replace",
-	"Remove one optic or install matching pair of optics",
-	"Replace with compatible optics for card to function",
+static char *be_port_misconfig_evt_severity[] =3D {
+	"KERN_WARN",
+	"KERN_INFO",
+	"KERN_ERR",
+	"KERN_WARN"
+};
+
+static char *phy_state_oper_desc[] =3D {
+	"Link is non-operational",
+	"Link is operational",
 	""
 };
=20
@@ -297,22 +303,56 @@ static void be_async_port_misconfig_event_process=
(struct be_adapter *adapter,
 {
 	struct be_async_event_misconfig_port *evt =3D
 			(struct be_async_event_misconfig_port *)compl;
-	u32 sfp_mismatch_evt =3D le32_to_cpu(evt->event_data_word1);
+	u32 sfp_misconfig_evt_word1 =3D le32_to_cpu(evt->event_data_word1);
+	u32 sfp_misconfig_evt_word2 =3D le32_to_cpu(evt->event_data_word2);
+	u8 phy_oper_state =3D PHY_STATE_OPER_MSG_NONE;
 	struct device *dev =3D &adapter->pdev->dev;
-	u8 port_misconfig_evt;
+	u8 msg_severity =3D DEFAULT_MSG_SEVERITY;
+	u8 phy_state_info;
+	u8 new_phy_state;
+
+	new_phy_state =3D
+		(sfp_misconfig_evt_word1 >> (adapter->hba_port_num * 8)) & 0xff;
+
+	if (new_phy_state =3D=3D adapter->phy_state)
+		return;
+
+	adapter->phy_state =3D new_phy_state;
=20
-	port_misconfig_evt =3D
-		((sfp_mismatch_evt >> (adapter->hba_port_num * 8)) & 0xff);
+	/* for older fw that doesn't populate link effect data */
+	if (!sfp_misconfig_evt_word2)
+		goto log_message;
=20
+	phy_state_info =3D
+		(sfp_misconfig_evt_word2 >> (adapter->hba_port_num * 8)) & 0xff;
+
+	if (phy_state_info & PHY_STATE_INFO_VALID) {
+		msg_severity =3D (phy_state_info & PHY_STATE_MSG_SEVERITY) >> 1;
+
+		if (be_phy_unqualified(new_phy_state))
+			phy_oper_state =3D (phy_state_info & PHY_STATE_OPER);
+	}
+
+log_message:
 	/* Log an error message that would allow a user to determine
 	 * whether the SFPs have an issue
 	 */
-	dev_info(dev, "Port %c: %s %s", adapter->port_name,
-		 be_port_misconfig_evt_desc[port_misconfig_evt],
-		 be_port_misconfig_remedy_desc[port_misconfig_evt]);
-
-	if (port_misconfig_evt =3D=3D INCOMPATIBLE_SFP)
-		adapter->flags |=3D BE_FLAGS_EVT_INCOMPATIBLE_SFP;
+	if (be_phy_state_unknown(new_phy_state))
+		dev_printk(be_port_misconfig_evt_severity[msg_severity], dev,
+			   "Port %c: Unrecognized Optics state: 0x%x. %s",
+			   adapter->port_name,
+			   new_phy_state,
+			   phy_state_oper_desc[phy_oper_state]);
+	else
+		dev_printk(be_port_misconfig_evt_severity[msg_severity], dev,
+			   "Port %c: %s %s",
+			   adapter->port_name,
+			   be_misconfig_evt_port_state[new_phy_state],
+			   phy_state_oper_desc[phy_oper_state]);
+
+	/* Log Vendor name and part no. if a misconfigured SFP is detected */
+	if (be_phy_misconfigured(new_phy_state))
+		adapter->flags |=3D BE_FLAGS_PHY_MISCONFIGURED;
 }
=20
 /* Grp5 CoS Priority evt */
diff --git a/drivers/net/ethernet/emulex/benet/be_cmds.h b/drivers/net/=
ethernet/emulex/benet/be_cmds.h
index f260ef3..0b9f741 100644
--- a/drivers/net/ethernet/emulex/benet/be_cmds.h
+++ b/drivers/net/ethernet/emulex/benet/be_cmds.h
@@ -176,10 +176,53 @@ struct be_async_event_qnq {
 	u32 flags;
 } __packed;
=20
-#define INCOMPATIBLE_SFP		0x3
+enum {
+	BE_PHY_FUNCTIONAL	=3D 0,
+	BE_PHY_NOT_PRESENT	=3D 1,
+	BE_PHY_DIFF_MEDIA	=3D 2,
+	BE_PHY_INCOMPATIBLE	=3D 3,
+	BE_PHY_UNQUALIFIED	=3D 4,
+	BE_PHY_UNCERTIFIED	=3D 5
+};
+
+#define PHY_STATE_MSG_SEVERITY		0x6
+#define PHY_STATE_OPER			0x1
+#define PHY_STATE_INFO_VALID		0x80
+#define	PHY_STATE_OPER_MSG_NONE		0x2
+#define DEFAULT_MSG_SEVERITY		0x1
+
+#define be_phy_state_unknown(phy_state) (phy_state > BE_PHY_UNCERTIFIE=
D)
+#define be_phy_unqualified(phy_state)				\
+			(phy_state =3D=3D BE_PHY_UNQUALIFIED ||	\
+			 phy_state =3D=3D BE_PHY_UNCERTIFIED)
+#define be_phy_misconfigured(phy_state)				\
+			(phy_state =3D=3D BE_PHY_INCOMPATIBLE ||	\
+			 phy_state =3D=3D BE_PHY_UNQUALIFIED ||	\
+			 phy_state =3D=3D BE_PHY_UNCERTIFIED)
+
+extern  char *be_misconfig_evt_port_state[];
+
 /* async event indicating misconfigured port */
 struct be_async_event_misconfig_port {
+ /* DATA_WORD1:
+  * phy state of port 0: bits 7 - 0
+  * phy state of port 1: bits 15 - 8
+  * phy state of port 2: bits 23 - 16
+  * phy state of port 3: bits 31 - 24
+  */
 	u32 event_data_word1;
+ /* DATA_WORD2:
+  * phy state info of port 0: bits 7 - 0
+  * phy state info of port 1: bits 15 - 8
+  * phy state info of port 2: bits 23 - 16
+  * phy state info of port 3: bits 31 - 24
+  *
+  * PHY STATE INFO:
+  * Link operability	 :bit 0
+  * Message severity	 :bit 2 - 1
+  * Rsvd			 :bits 6 - 3
+  * phy state info valid	 :bit 7
+  */
 	u32 event_data_word2;
 	u32 rsvd0;
 	u32 flags;
diff --git a/drivers/net/ethernet/emulex/benet/be_main.c b/drivers/net/=
ethernet/emulex/benet/be_main.c
index e4fc874..4ecd8c2 100644
--- a/drivers/net/ethernet/emulex/benet/be_main.c
+++ b/drivers/net/ethernet/emulex/benet/be_main.c
@@ -4089,6 +4089,7 @@ static void be_setup_init(struct be_adapter *adap=
ter)
 	adapter->if_handle =3D -1;
 	adapter->be3_native =3D false;
 	adapter->if_flags =3D 0;
+	adapter->phy_state =3D BE_UNKNOWN_PHY_STATE;
 	if (be_physfn(adapter))
 		adapter->cmd_privileges =3D MAX_PRIVILEGES;
 	else
@@ -4961,11 +4962,13 @@ static void be_log_sfp_info(struct be_adapter *=
adapter)
 	status =3D be_cmd_query_sfp_info(adapter);
 	if (!status) {
 		dev_err(&adapter->pdev->dev,
-			"Unqualified SFP+ detected on %c from %s part no: %s",
-			adapter->port_name, adapter->phy.vendor_name,
+			"Port %c: %s Vendor: %s part no: %s",
+			adapter->port_name,
+			be_misconfig_evt_port_state[adapter->phy_state],
+			adapter->phy.vendor_name,
 			adapter->phy.vendor_pn);
 	}
-	adapter->flags &=3D ~BE_FLAGS_EVT_INCOMPATIBLE_SFP;
+	adapter->flags &=3D ~BE_FLAGS_PHY_MISCONFIGURED;
 }
=20
 static void be_worker(struct work_struct *work)
@@ -5009,7 +5012,7 @@ static void be_worker(struct work_struct *work)
 	if (!skyhawk_chip(adapter))
 		be_eqd_update(adapter, false);
=20
-	if (adapter->flags & BE_FLAGS_EVT_INCOMPATIBLE_SFP)
+	if (adapter->flags & BE_FLAGS_PHY_MISCONFIGURED)
 		be_log_sfp_info(adapter);
=20
 reschedule:
--=20
