 1 file changed, 1 insertion(+), 2 deletions(-)

--- a/drivers/infiniband/hw/hisilicon/hns/hns_roce_v1_hw.c
+++ b/drivers/infiniband/hw/hisilicon/hns/hns_roce_v1_hw.c
