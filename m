+};
+
+struct mlx5_cqwq {
+	struct mlx5_frag_buf	frag_buf;
+	__be32			*db;
+	u32			sz_m1;
+	u32			frag_sz_m1;
+	u32			cc; /* consumer counter */
+	u8			log_sz;
+	u8			log_stride;
+	u8			log_frag_strides;
+};
+
+struct mlx5_wq_ll {
+	void			*buf;
+	__be32			*db;
+	__be16			*tail_next;
+	u16			sz_m1;
+	u16			head;
+	u16			wqe_ctr;
+	u16			cur_sz;
+	u8			log_stride;
+};
