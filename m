+	u32 spi;
+
+	spi = xfrm6_tunnel_addr_hash((xfrm_address_t *)&x->props.saddr);
+	
+	t = xfrm_state_lookup((xfrm_address_t *)&x->id.daddr,
+				      spi, IPPROTO_IPV6, AF_INET6);
+	if (!t) {
+		t = ipcomp6_tunnel_create(x);
+		if (!t) {
+			err = -EINVAL;
+			goto out;
+		}
+		xfrm_state_insert(t);
+		xfrm_state_hold(t);
+	}
+	x->tunnel = t;
+	atomic_inc(&t->tunnel_users);
+
+out:
+	return err;
+}
