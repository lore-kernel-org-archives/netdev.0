> +	PBNI_NET_OBJECT pnob = netdev->priv;
> +	struct dev_mc_list *mc_ptr;
> +	SA_MAC_ADDRESS mac_addr[32];
> +	int i;
> +
> +	if (netdev->flags & IFF_ALLMULTI) {
