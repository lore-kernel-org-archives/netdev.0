>>
>> +#ifdef CONFIG_SCHED_DEBUG
>> +static inline unsigned int get_sysctl_timer_migration(void)
>> +{
>> + =A0 =A0 =A0 return sysctl_timer_migration;
>> +}
>> +#else
>> +static inline unsigned int get_sysctl_timer_migration(void)
>> +{
>> + =A0 =A0 =A0 return 1;
>> +}
>> +#endif
