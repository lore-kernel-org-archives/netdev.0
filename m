 =20
@@ -2284,16 +2287,15 @@ int bond_arp_rcv(const struct sk_buff *skb, str=
uct bonding *bond,
  	struct arphdr *arp =3D (struct arphdr *)skb->data;
  	unsigned char *arp_ptr;
  	__be32 sip, tip;
