-			type = dest[i].type ==
-				MLX5_FLOW_DESTINATION_TYPE_COUNTER;
-			*modify_mask |= type ? count : dst;
-		}
-rule_found:
-		handle->rule[i] = rule;
-	} while (++i < dest_num);
