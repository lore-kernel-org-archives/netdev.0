-	if (likely((cqe->hds_ip_ext & CQE_L3_OK) &&
-		   (cqe->hds_ip_ext & CQE_L4_OK))) {
-		skb->ip_summed = CHECKSUM_UNNECESSARY;
-		if (cqe_is_tunneled(cqe)) {
-			skb->csum_level = 1;
-			skb->encapsulation = 1;
-			rq->stats.csum_unnecessary_inner++;
-		}
-		return;
-	}
-csum_none:
-	skb->ip_summed = CHECKSUM_NONE;
-	rq->stats.csum_none++;
