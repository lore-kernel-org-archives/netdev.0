-			rate->flags |=3D IEEE80211_TX_RC_USE_SHORT_PREAMBLE;
-		if (mac->opmode =3D=3D NL80211_IFTYPE_AP ||
-			mac->opmode =3D=3D NL80211_IFTYPE_ADHOC) {
