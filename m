+/* Rotate right two 32 bit numbers as a 56 bit number */
+#define ror56(hi, lo, n)					\
+do {								\
+	u32 t =3D lo & ((1 << n) - 1);				\
+	lo =3D (lo >> n) | ((hi & ((1 << n) - 1)) << (32 - n));	\
+	hi =3D (hi >> n) | (t << (24-n));				\
+} while(0)
