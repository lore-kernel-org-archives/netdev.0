-			}
-
-			bw_sum += ets->tc_tx_bw[i];
-		}
-	}
-
-	if (bw_sum != 0 && bw_sum != 100) {
-		netdev_err(netdev,
-			   "Failed to validate ETS: BW sum is illegal\n");
-		return -EINVAL;
-	}
