+
+static void nv_gear_backoff_reseed(struct net_device *dev)
+{
+	u8 __iomem *base = get_hwbase(dev);
+	u32 temp, seedset, combined_seed;
+	int i;
+
+	/* Setup seed for free running LFSR */
+	get_random_bytes(&combined_seed, sizeof(combined_seed));
+
+	/* Seeds can not be zero. Identical seeds are allowed. */
+	if ((combined_seed & NVREG_BKOFFCTRL_SEED_MASK) == 0)
+		combined_seed |= NVREG_BKOFFCTRL_SEED_DEFAULT;
+	if ((combined_seed & (NVREG_BKOFFCTRL_SEED_MASK << NVREG_BKOFFCTRL_GEAR)) == 0)
+		combined_seed |= (NVREG_BKOFFCTRL_SEED_DEFAULT << NVREG_BKOFFCTRL_GEAR);
+
+	/* No need to disable tx here */
+	temp = NVREG_BKOFFCTRL_DEFAULT | (0 << NVREG_BKOFFCTRL_SELECT);
+	temp |= combined_seed & NVREG_BKOFFCTRL_SEED_MASK;
+	temp |= (combined_seed & (NVREG_BKOFFCTRL_SEED_MASK << NVREG_BKOFFCTRL_GEAR));
+	writel(temp, base + NvRegBackOffControl);
+
+    	/* Setup seeds for all gear LFSRs. */
+	get_random_bytes(&seedset, sizeof(seedset));
+	seedset = seedset % BACKOFF_SEEDSET_ROWS;
+	for (i = 1; i <= BACKOFF_SEEDSET_LFSRS; i++)
+	{
+		temp = NVREG_BKOFFCTRL_DEFAULT | (i << NVREG_BKOFFCTRL_SELECT);
+		temp |= main_seedset[seedset][i-1] & NVREG_BKOFFCTRL_SEED_MASK;
+		temp |= ((gear_seedset[seedset][i-1] & NVREG_BKOFFCTRL_SEED_MASK)
+			 << NVREG_BKOFFCTRL_GEAR);
+		writel(temp, base + NvRegBackOffControl);
+	}
+}
