--- /dev/null
+++ b/kernel/time/clocksync.c
@@ -0,0 +1,108 @@
+/*
+ * Utility code which helps transforming between hardware time stamps
+ * generated by a clocksource and system time.
+ *
+ * Copyright (C) 2008 Intel, Patrick Ohly (patrick.ohly@intel.com)
