+{
+	struct rlimit r = {RLIM_INFINITY, RLIM_INFINITY};
+	int map_types[] = {BPF_MAP_TYPE_LRU_HASH,
+			   BPF_MAP_TYPE_LRU_PERCPU_HASH};
+	int i;
+
+	setbuf(stdout, NULL);
